{
  "version": 2,
  "framework": null,
  "outputDirectory": "web",
  "buildCommand": "",
  "installCommand": "",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/static/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    }
  ]
}
